{
  "name": "8n8-monorepo",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "typecheck": "pnpm -r --if-present typecheck && tsc -p e2e",
    "check": "biome check . && depcruise packages apps --config .dependency-cruiser.cjs",
    "dev": "node scripts/dev.mjs",
    "dev:server": "tsx watch --env-file-if-exists=.env apps/cli/src/main.ts --no-open",
    "dev:ui": "pnpm --filter @8n8/ui dev",
    "start": "pnpm --filter 8-n-8 build && node --env-file-if-exists=.env apps/cli/dist/8n8.mjs --no-open",
    "build:all": "pnpm install && pnpm build:cli && pnpm build:ext",
    "build:cli": "pnpm --filter 8-n-8 package",
    "build:ext": "pnpm --filter 8n8-vscode package",
    "install:cli:global": "pnpm build:cli && npm install -g ./release/8-n-8-0.1.0.tgz",
    "open": "pnpm --filter 8-n-8 build && node scripts/open.mjs",
    "test": "pnpm -r --if-present test",
    "e2e": "pnpm --filter 8-n-8 build && playwright test",
    "e2e:map": "node scripts/e2e-map.mjs",
    "verify": "node scripts/verify.mjs",
    "prepare": "git config core.hooksPath .githooks",
    "prints": "pnpm --filter 8-n-8 build && node scripts/prints-readme.mjs"
  },
  "devDependencies": {
    "@8n8/model": "workspace:*",
    "@biomejs/biome": "2.5.15",
    "@jridgewell/trace-mapping": "0.3.31",
    "@playwright/test": "1.64.0",
    "@types/node": "26.6.5",
    "dependency-cruiser": "18.6.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.0.4"
  }
}
