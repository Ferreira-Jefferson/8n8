{
  "name": "8n8",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "test": "pnpm -r --if-present test",
    "typecheck": "pnpm -r --if-present typecheck && tsc -p e2e",
    "check": "biome check . && depcruise packages apps --config .dependency-cruiser.cjs",
    "dev": "node scripts/dev.mjs",
    "dev:server": "tsx watch packages/server/src/main.ts",
    "dev:web": "pnpm --filter @8n8/web dev",
    "start": "pnpm --filter @8n8/web build && tsx packages/server/src/main.ts start",
    "e2e": "playwright test",
    "prepare": "git config core.hooksPath .githooks"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@8n8/model": "workspace:*",
    "@playwright/test": "1.64.0",
    "@types/node": "22.20.5",
    "dependency-cruiser": "18.6.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.0.4"
  }
}
