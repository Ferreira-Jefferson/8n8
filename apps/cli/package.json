{
  "name": "8n8",
  "version": "0.0.1",
  "description": "Mapa visual de código: nós e arestas no estilo n8n, do repositório até as linhas reais.",
  "keywords": [
    "code-map",
    "visualization",
    "diagram",
    "flow",
    "tree-sitter",
    "python",
    "typescript",
    "cli"
  ],
  "homepage": "https://github.com/Ferreira-Jefferson/8n8#readme",
  "bugs": {
    "url": "https://github.com/Ferreira-Jefferson/8n8/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ferreira-Jefferson/8n8.git",
    "directory": "apps/cli"
  },
  "license": "GPL-3.0-only",
  "author": "Jefferson Ferreira",
  "type": "module",
  "bin": {
    "8n8": "dist/8n8.mjs"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "build": "pnpm --filter @8n8/ui build && tsx src/build.ts",
    "package": "pnpm run build && pnpm pack --pack-destination ../../release"
  },
  "devDependencies": {
    "@8n8/server": "workspace:*",
    "@hono/node-server": "2.1.5",
    "@types/node": "26.6.5",
    "dependency-cruiser": "18.6.0",
    "esbuild": "0.28.2",
    "hono": "4.13.13",
    "yaml": "2.9.1"
  }
}
