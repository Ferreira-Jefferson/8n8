# Provedor de LLM: openrouter (padrão) ou openai-compatible (OpenAI, Ollama, LM Studio).
APP8N8_LLM_PROVIDER=

# Provedor openrouter
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=

# Provedor openai-compatible: a URL da API (ex.: http://localhost:11434/v1 no Ollama). A chave é opcional em servidor local.
APP8N8_LLM_API_KEY=
APP8N8_LLM_BASE_URL=

# Modelo do resumo e modelo do revisor. Vazio usa o padrão do provedor; o revisor usa o modelo do resumo.
APP8N8_MODEL=
APP8N8_REVIEW_MODEL=
